rules_version = '2';

// Server-side protection for the collections that assets/js/api.js writes to.
// Deploy with: firebase deploy --only firestore:rules (see docs/FIREBASE_SECURITY.md).
//
// Principles
//  - Everything is denied unless a rule below allows it.
//  - A signed-in user can only touch their own documents.
//  - Writes are validated here, so calling Firestore directly (skipping the site)
//    cannot store oversized, forged or privileged data.
//  - Status and timestamps are set at creation and cannot be edited by the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Documents that carry a userId field (appointments, requests, deliveries).
    function ownsDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function maxFields(n) {
      return request.resource.data.keys().size() <= n;
    }

    // A provider is a signed-in account whose token carries providerId (set with the Admin SDK).
    // It can only see and change requests addressed to that provider.
    function providerOwns() {
      return signedIn()
        && request.auth.token.providerId is string
        && request.auth.token.providerId == resource.data.doctorId;
    }

    // Who may move an appointment request from one status to another. Mirrors
    // assets/js/appointment-status.js and docs/APPOINTMENT_STATUS.md.
    function patientMayCancel(from) {
      return from in ['submitted', 'under_review', 'confirmed'];
    }

    function providerMayMove(from, to) {
      return (from == 'submitted' && to in ['under_review', 'declined'])
        || (from == 'under_review' && to in ['confirmed', 'declined', 'cancelled'])
        || (from == 'confirmed' && to == 'cancelled');
    }

    // Fields a user must never be able to grant themselves.
    function noPrivilegedFields() {
      return !request.resource.data.keys().hasAny(['role', 'roles', 'isAdmin', 'admin', 'verified', 'moderator']);
    }

    function shortText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // ---- Accounts -------------------------------------------------------

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && maxFields(20)
        && noPrivilegedFields()
        && shortText('name', 100)
        && shortText('email', 254);
    }

    match /patients/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && maxFields(40)
        && noPrivilegedFields()
        && shortText('name', 100);
    }

    // ---- Requests created by signed-in users ----------------------------

    // The document id is the request's own reference, so a repeated create (double tap, retry)
    // finds the document already there and is refused instead of making a second booking.
    match /appointments/{id} {
      allow read: if ownsDoc() || providerOwns();
      allow delete: if ownsDoc();
      allow create: if createsOwnDoc()
        && maxFields(30)
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && shortText('notes', 1000);
      allow update: if
        // the patient cancelling their own request, and nothing else
        (ownsDoc()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && patientMayCancel(resource.data.status))
        // the provider moving it along the allowed path, and nothing else
        || (providerOwns()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
          && request.resource.data.statusUpdatedAt == request.time
          && providerMayMove(resource.data.status, request.resource.data.status));
    }

    match /emergencyRequests/{id} {
      allow read, delete: if ownsDoc();
      allow create: if createsOwnDoc()
        && maxFields(10)
        && request.resource.data.status == 'requested'
        && request.resource.data.timestamp == request.time
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40;
      allow update: if false;
    }

    match /medicineDeliveries/{id} {
      allow read, delete: if ownsDoc();
      allow create: if createsOwnDoc()
        && maxFields(25)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ---- Everything else is closed --------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
